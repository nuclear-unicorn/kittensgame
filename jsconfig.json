{
	// Type-checking config only — nothing is compiled or emitted, ever.
	// Files are opted in one by one with a `// @ts-check` comment on line 1.
	"compilerOptions": {
		"noEmit": true,
		"allowJs": true,
		"checkJs": false,
		// "lib" is what the CHECKER assumes exists at runtime; it does not
		// change the shipped code or the supported browsers.
		"lib": ["es2017", "dom"],
		"strict": false,
		// Prototype defaults are declared `foo: /** @type {any} */ (null)` — the
		// @type tag above the field is the real type, the cast just lets dojo's
		// null placeholder through. Fields that stay null at runtime say `|null`.
		"strictNullChecks": true,
		"skipLibCheck": true
	},
	"include": [
		"types/**/*.d.ts",
		"core.js",
		"config.js",
		"game.js",
		"i18n.js",
		"js/**/*.js"
	],
	"exclude": ["node_modules", "lib", "types-dist"]
}
